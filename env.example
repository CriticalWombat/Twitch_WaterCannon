# ── Twitch credentials ───────────────────────────────────────────────────────
# Get a Client ID and Client Secret by registering an app at https://dev.twitch.tv/console
TWITCH_CLIENT_ID=PLACEHOLDER_CLIENT_ID
TWITCH_CLIENT_SECRET=PLACEHOLDER_CLIENT_SECRET

# A user REFRESH token with the  channel:read:redemptions  scope.
# The app uses this to obtain (and silently rotate) access tokens – you
# never need to touch it again after the first setup.
#
# How to get one (one-time step):
#   1. Go to https://twitchtokengenerator.com
#   2. Select the  channel:read:redemptions  scope
#   3. Copy the "Refresh Token" value here (NOT the access token)
TWITCH_REFRESH_TOKEN=PLACEHOLDER_REFRESH_TOKEN

# Numeric broadcaster/channel user ID (not the channel name).
# Look it up at https://www.streamweasels.com/tools/convert-twitch-username-to-user-id/
TWITCH_BROADCASTER_ID=PLACEHOLDER_BROADCASTER_ID

# ── Reward configuration ─────────────────────────────────────────────────────
# Must match the channel point reward title EXACTLY (case-sensitive).
REWARD_NAME="Water Cannon"

# ── GPIO ─────────────────────────────────────────────────────────────────────
# BCM pin number connected to your relay / MOSFET / cannon trigger.
GPIO_PIN=18

# How long (in seconds) the pin stays HIGH per redemption.
PULSE_DURATION_SEC=0.25

# Second redeem: same behaviour, longer pulse.
# Must match the Power-up title EXACTLY (case-sensitive).
REWARD_NAME_5SHOT="Water Cannon 5-shot"
PULSE_DURATION_5SHOT_SEC=1.25

# Soak leaderboard: shots scored per redeem, and the First Blood bonus.
SHOTS_REWARD=1
SHOTS_5SHOT=5
FIRST_BLOOD_BONUS=1

# Sessions: a late stream.online keeps a session active this recently (minutes, 180 = 3h);
# a session idle this long (hours) is closed as stale by the next redemption.
SESSION_ONLINE_GRACE_MIN=180
SESSION_IDLE_HOURS=3

# Overlay web server for OBS (read-only). Browser source URL: http://<pi-address>:5000/overlay
WEB_ENABLED=1
WEB_PORT=5000
OVERLAY_TOP_N=5





