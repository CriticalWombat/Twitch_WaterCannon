#
# How to get one (one-time step):
#   1. Go to https://twitchtokengenerator.com
#   2. Select the  channel:read:redemptions  scope
#   3. Copy the "Refresh Token" value here (NOT the access token)
TWITCH_REFRESH_TOKEN=PLACEHOLDER_REFRESH_TOKEN

